run = "cd laravel && php artisan serve --host=0.0.0.0 --port=8080"
entrypoint = "laravel/public/index.php"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "cd laravel && php artisan serve --host=0.0.0.0 --port=8080"]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "cd laravel && composer install --no-interaction --prefer-dist --optimize-autoloader && cp -n .env.example .env && touch database/database.sqlite && php artisan key:generate --force && php artisan migrate --force && php artisan db:seed --force"]

[[ports]]
localPort = 8080
externalPort = 80
