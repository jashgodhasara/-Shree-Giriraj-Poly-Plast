<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Title>Shree Giriraj Poly Plast — ERP User Credentials</Title>
  <Author>Shree Giriraj ERP</Author>
  <Created>2026-08-17T00:00:00Z</Created>
  <Description>Confidential: ERP Login Credentials</Description>
 </DocumentProperties>
 <Styles>
  <Style ss:ID="title">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="16" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#4F46E5" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#312E81"/>
   </Borders>
  </Style>
  <Style ss:ID="subtitle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#94A3B8"/>
   <Interior ss:Color="#1E1B4B" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="header">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Bold="1" ss:Color="#FFFFFF"/>
   <Interior ss:Color="#6366F1" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#4F46E5"/>
   </Borders>
  </Style>
  <Style ss:ID="row_even">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#1E293B"/>
   <Interior ss:Color="#F8F9FF" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="row_odd">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#1E293B"/>
   <Interior ss:Color="#FFFFFF" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="pwd_known">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Courier New" ss:Size="11" ss:Bold="1" ss:Color="#059669"/>
   <Interior ss:Color="#ECFDF5" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#A7F3D0"/>
   </Borders>
  </Style>
  <Style ss:ID="pwd_unknown">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#94A3B8" ss:Italic="1"/>
   <Interior ss:Color="#F8FAFC" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="role_admin">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1" ss:Color="#5B21B6"/>
   <Interior ss:Color="#EDE9FE" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#DDD6FE"/>
   </Borders>
  </Style>
  <Style ss:ID="role_staff">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1" ss:Color="#065F46"/>
   <Interior ss:Color="#D1FAE5" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#A7F3D0"/>
   </Borders>
  </Style>
  <Style ss:ID="active_yes">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Bold="1" ss:Color="#065F46"/>
   <Interior ss:Color="#D1FAE5" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#A7F3D0"/>
   </Borders>
  </Style>
  <Style ss:ID="warning">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#92400E"/>
   <Interior ss:Color="#FEF3C7" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#FCD34D"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#FCD34D"/>
   </Borders>
  </Style>
  <Style ss:ID="note_cell">
   <Alignment ss:Horizontal="Left" ss:Vertical="Center" ss:WrapText="1"/>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#475569"/>
   <Interior ss:Color="#F1F5F9" ss:Pattern="Solid"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="ERP Credentials">
  <Table ss:DefaultRowHeight="22">
   <Column ss:Width="40"/>
   <Column ss:Width="160"/>
   <Column ss:Width="200"/>
   <Column ss:Width="150"/>
   <Column ss:Width="90"/>
   <Column ss:Width="100"/>
   <Column ss:Width="110"/>

   <!-- TITLE ROW -->
   <Row ss:Height="40">
    <Cell ss:MergeAcross="6" ss:StyleID="title">
     <Data ss:Type="String">🏭  SHREE GIRIRAJ POLY PLAST — ERP USER CREDENTIALS</Data>
    </Cell>
   </Row>
   <!-- SUBTITLE ROW -->
   <Row ss:Height="22">
    <Cell ss:MergeAcross="6" ss:StyleID="subtitle">
     <Data ss:Type="String">CONFIDENTIAL — Keep this document secure. Generated: 17-Aug-2026 06:56 AM</Data>
    </Cell>
   </Row>
   <!-- EMPTY ROW -->
   <Row ss:Height="10"/>

   <!-- HEADER ROW -->
   <Row ss:Height="28">
    <Cell ss:StyleID="header"><Data ss:Type="String">Sr No</Data></Cell>
    <Cell ss:StyleID="header"><Data ss:Type="String">Full Name</Data></Cell>
    <Cell ss:StyleID="header"><Data ss:Type="String">Email / Username</Data></Cell>
    <Cell ss:StyleID="header"><Data ss:Type="String">Password</Data></Cell>
    <Cell ss:StyleID="header"><Data ss:Type="String">Role</Data></Cell>
    <Cell ss:StyleID="header"><Data ss:Type="String">Status</Data></Cell>
    <Cell ss:StyleID="header"><Data ss:Type="String">Created On</Data></Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:StyleID="row_even"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="row_even"><Data ss:Type="String">(Default)</Data></Cell>
    <Cell ss:StyleID="row_even"><Data ss:Type="String">(not set)</Data></Cell>
    <Cell ss:StyleID="pwd_unknown"><Data ss:Type="String">— (set by user) —</Data></Cell>
    <Cell ss:StyleID="role_admin"><Data ss:Type="String">ADMIN</Data></Cell>
    <Cell ss:StyleID="active_yes"><Data ss:Type="String">✅ Active</Data></Cell>
    <Cell ss:StyleID="row_even"><Data ss:Type="String">—</Data></Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:StyleID="row_odd"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="row_odd"><Data ss:Type="String">Fua (Partner 1)</Data></Cell>
    <Cell ss:StyleID="row_odd"><Data ss:Type="String">fua@giriraj.com</Data></Cell>
    <Cell ss:StyleID="pwd_unknown"><Data ss:Type="String">— (set by user) —</Data></Cell>
    <Cell ss:StyleID="role_staff"><Data ss:Type="String">PARTNER</Data></Cell>
    <Cell ss:StyleID="active_yes"><Data ss:Type="String">✅ Active</Data></Cell>
    <Cell ss:StyleID="row_odd"><Data ss:Type="String">—</Data></Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:StyleID="row_even"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="row_even"><Data ss:Type="String">Partner 2</Data></Cell>
    <Cell ss:StyleID="row_even"><Data ss:Type="String">partner@giriraj.com</Data></Cell>
    <Cell ss:StyleID="pwd_unknown"><Data ss:Type="String">— (set by user) —</Data></Cell>
    <Cell ss:StyleID="role_staff"><Data ss:Type="String">PARTNER</Data></Cell>
    <Cell ss:StyleID="active_yes"><Data ss:Type="String">✅ Active</Data></Cell>
    <Cell ss:StyleID="row_even"><Data ss:Type="String">—</Data></Cell>
   </Row>
   <Row ss:Height="24">
    <Cell ss:StyleID="row_odd"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="row_odd"><Data ss:Type="String">Admin</Data></Cell>
    <Cell ss:StyleID="row_odd"><Data ss:Type="String">admin@shreegiriraj.com</Data></Cell>
    <Cell ss:StyleID="pwd_known"><Data ss:Type="String">Admin@1234</Data></Cell>
    <Cell ss:StyleID="role_admin"><Data ss:Type="String">ADMIN</Data></Cell>
    <Cell ss:StyleID="active_yes"><Data ss:Type="String">✅ Active</Data></Cell>
    <Cell ss:StyleID="row_odd"><Data ss:Type="String">2026-08-17</Data></Cell>
   </Row>

   <!-- EMPTY ROW -->
   <Row ss:Height="10"/>

   <!-- WARNING ROW -->
   <Row ss:Height="36">
    <Cell ss:MergeAcross="6" ss:StyleID="warning">
     <Data ss:Type="String">⚠️  SECURITY NOTICE: This document contains sensitive credentials. Do NOT share via email or messaging apps. Store securely and destroy when no longer needed. Passwords marked as (set by user) cannot be recovered — use Admin panel to reset them.</Data>
    </Cell>
   </Row>

   <!-- EMPTY ROW -->
   <Row ss:Height="10"/>

   <!-- NOTES -->
   <Row ss:Height="20">
    <Cell ss:MergeAcross="6" ss:StyleID="note_cell">
     <Data ss:Type="String">📌 Login URL: http://localhost:8000/login  |  To reset a password: Login as Admin → User Management → Edit User → Set new password</Data>
    </Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:MergeAcross="6" ss:StyleID="note_cell">
     <Data ss:Type="String">📌 Roles: ADMIN = Full access to all modules + User Management  |  STAFF = Standard access  |  PARTNER = Partner access</Data>
    </Cell>
   </Row>

  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <Selected/>
   <FreezePanes/>
   <FrozenNoSplit/>
   <SplitHorizontal>4</SplitHorizontal>
   <TopRowBottomPane>4</TopRowBottomPane>
   <ActivePane>2</ActivePane>
   <Print>
    <PaperSizeIndex>9</PaperSizeIndex>
    <HorizontalResolution>600</HorizontalResolution>
    <VerticalResolution>600</VerticalResolution>
    <Landscape/>
   </Print>
  </WorksheetOptions>
 </Worksheet>
</Workbook>
